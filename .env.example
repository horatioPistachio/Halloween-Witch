OPENAI_API_KEY=
ELEVEN_LABS_API_KEY=

# Optional overrides (defaults shown in comments)
# WITCH_MODEL=gpt-realtime-2.1-mini
# WITCH_INPUT_DEVICE=
# WITCH_VAD=semantic_vad
# WITCH_REASONING_EFFORT=low
# WITCH_MAX_OUTPUT_TOKENS=600
# WITCH_USAGE_LOG=usage.jsonl
# WITCH_LOG_LEVEL=INFO
# WITCH_TTS=on
# WITCH_VOICE_ID=xBIfEFAROTtux2FvqTLj
# WITCH_TTS_MODEL=eleven_v4_turbo
# WITCH_TTS_STABILITY=
# WITCH_OUTPUT_DEVICE=
# WITCH_GATE_TAIL_MS=400

# Run control (Raspberry Pi). WITCH_TRIGGER=none keeps the always-listening mode.
# WITCH_TRIGGER=none
# WITCH_PIR_PIN=27
# WITCH_PIR_POWER_PIN=17
# WITCH_ACTIVATE_PIN=22
# WITCH_PIR_WARMUP_S=60
# WITCH_ACTIVATE_MS=1000
# WITCH_IDLE_TIMEOUT_S=30
# WITCH_MAX_CONVERSATION_S=120
# WITCH_COOLDOWN_S=30
# WITCH_SETUP_TIMEOUT_S=20
# WITCH_OPENING=on
# WITCH_OPENING_DELAY_MS=0
