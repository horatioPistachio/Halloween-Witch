OPENAI_API_KEY=
ELEVEN_LABS_API_KEY=

# Optional overrides (defaults shown in comments)
# WITCH_MODEL=gpt-realtime-2.1-mini
# WITCH_INPUT_DEVICE=
# WITCH_VAD=semantic_vad
# WITCH_REASONING_EFFORT=low
# WITCH_MAX_OUTPUT_TOKENS=600
# WITCH_USAGE_LOG=usage.jsonl
# WITCH_LOG_LEVEL=INFO
# WITCH_TTS=on
# WITCH_VOICE_ID=xBIfEFAROTtux2FvqTLj
# WITCH_TTS_MODEL=eleven_v4_turbo
# WITCH_TTS_STABILITY=
# WITCH_OUTPUT_DEVICE=
# WITCH_GATE_TAIL_MS=400

# Run control (Raspberry Pi, or a laptop with an ESP32 Feather). WITCH_TRIGGER=none keeps the always-listening mode.
# WITCH_TRIGGER=none
# WITCH_HARDWARE=gpio              # gpio (Raspberry Pi pins) or esp32 (Feather over USB serial)
# WITCH_ESP32_PORT=COM7            # required when WITCH_HARDWARE=esp32
# Pins are BCM numbers on gpio (defaults 27/17/22) and raw ESP32 GPIO numbers on esp32 (defaults 27/33/32)
# WITCH_PIR_PIN=27
# WITCH_PIR_POWER_PIN=17
# WITCH_ACTIVATE_PIN=22
# WITCH_PIR_WARMUP_S=60
# WITCH_ACTIVATE_MS=1000
# WITCH_IDLE_TIMEOUT_S=30
# WITCH_MAX_CONVERSATION_S=120
# WITCH_COOLDOWN_S=30
# WITCH_SETUP_TIMEOUT_S=20
# WITCH_OPENING=on
# WITCH_OPENING_DELAY_MS=0
# WITCH_PRESENCE_THRESHOLD_S=10    # seconds of PIR-high needed to activate (x0.5-1.5 each time); 0 = activate on the first blip
# WITCH_PRESENCE_DECAY=0.5         # confidence lost per second the PIR is low
# WITCH_AMBIENT_INTERVAL_S=300     # quiet time before she speaks on her own (x0.5-1.5 each time); 0 = never
# WITCH_PHRASE_CACHE_DIR=          # default .cache/phrases in the repo; empty disables the cache
# Eyes: PWM LEDs shared with the witch's own PCB. The pin is high impedance whenever we are not driving it.
# WITCH_EYES=on                    # off disables (also --no-eyes)
# WITCH_EYES_PIN=12                # GPIO12 on the ESP32, BCM12 on the Pi
# WITCH_EYES_MAX_DUTY=60           # hard ceiling, percent of full PWM duty (about 2 V of 3.3 V); set after measuring
# WITCH_EYES_SPEAK_LEVEL=0.6       # brightness while she speaks, as a fraction of the ceiling
# WITCH_EYES_FLICKER_LEVEL=0.15    # brightness of the flicker when motion is seen
# WITCH_EYES_FLICKER_COOLDOWN_S=5  # minimum time between flickers
# WITCH_EYES_PCB_HOLDOFF_S=15      # time from the start of the pulse that the witch's PCB drives the eyes
